{
  "folders": [
    {
      "path": ".",
      "name": "GettingStartedSDK (Build Scripts & Infrastructure)"
    },
    {
      "path": "..",
      "name": "Repository Root (Documentation & Extras)"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/.venv/bin/python",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.python",
    "[python]": {
      "editor.defaultFormatter": "ms-python.python",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "[markdown]": {
      "editor.wordWrap": "on",
      "editor.formatOnSave": true
    },
    "files.exclude": {
      "**/mcuxpresso-sdk": true,
      "**/esp-idf": true,
      "**/ameba-rtos-d": false,
      "**/.git": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": false
    },
    "search.exclude": {
      "**/mcuxpresso-sdk": true,
      "**/esp-idf": true,
      "**/ameba-rtos-d": true,
      "**/.venv": true,
      "**/targets/*/sdk/**": true
    },
    "files.watcherExclude": {
      "**/targets/*/sdk/**": true,
      "**/ameba-rtos-d/**": true,
      "**/esp-idf/**": true,
      "**/mcuxpresso-sdk/**": true
    },
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
    },
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-cmake-tools.cmake-tools",
      "ms-vscode.cmake-language-support",
      "marus25.cortex-debug",
      "gitlab.gitlab-workflow"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: IRIS-W1 doctor",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/iris_w1_build.py",
        "args": ["doctor"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: IRIS-W1 clone",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/iris_w1_build.py",
        "args": ["clone", "--full"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: IRIS-W1 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/iris_w1_build.py",
        "args": ["build", "hello_world"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W5 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/nora_w5_build.py",
        "args": ["build", "ble_wifi_provisioning"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W4 clone",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/nora_w4_build.py",
        "args": ["clone"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W4 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/nora_w4_build.py",
        "args": ["build", "hello_world"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W3 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/nora_w3_build.py",
        "args": ["build"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Python: Setup venv",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/setup_venv.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Cortex Debug: IRIS-W1 (J-Link)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "jlink",
        "device": "RW612",
        "interface": "swd",
        "ipAddress": "localhost",
        "port": 2331,
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
      },
      {
        "name": "Cortex Debug: IRIS-W1 (MCU-Link)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "jlink",
        "device": "RW612",
        "interface": "swd",
        "ipAddress": "localhost",
        "port": 2331,
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
      },
      {
        "name": "Cortex Debug: NORA-W5 (XDS110)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "xds110",
        "device": "CC3520SF",
        "interface": "jtag",
        "ipAddress": "localhost",
        "port": 55000,
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
      },
      {
        "name": "Cortex Debug: NORA-W3 (J-Link)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "jlink",
        "device": "RTL8721D",
        "interface": "swd",
        "ipAddress": "localhost",
        "port": 2331,
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}"
      },
      {
        "name": "Cortex Debug: NORA-W4 (OpenOCD/ESP-Prog)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "openocd",
        "device": "esp32c6",
        "interface": "jtag",
        "ipAddress": "localhost",
        "port": 3333,
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/esp-idf/examples/get-started/hello_world",
        "executable": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/esp-idf/examples/get-started/hello_world/build/hello_world.elf"
      },
      {
        "name": "ESP-IDF Monitor: NORA-W4",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/esp-idf/tools/idf.py",
        "args": ["monitor", "--print-filter=*"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/esp-idf/examples/get-started/hello_world",
        "justMyCode": false
      },
      {
        "name": "Serial Logger (all boards)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/serial_logger.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      },
      {
        "name": "Flash Helper (multi-board)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}/scripts/flash_helper.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:GettingStartedSDK (Build Scripts & Infrastructure)}",
        "justMyCode": false
      }
    ]
  }
}
