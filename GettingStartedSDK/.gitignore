# Build artifacts
build/
dist/

# Python virtual environments
.venv/
venv/
*.pyc
__pycache__/
.pytest_cache/

# Object files & libraries
*.o
*.a
*.out
*.bin
*.elf
*.map

# Config cache (per-platform, legacy root location)
.iris_w1_build.*.json
.nora_w3_build.*.json
.nora_w4_build.*.json
.nora_w5_build.*.json

# Per-target base folders: track the skeleton, ignore everything generated.
# The directories are re-included first because git will not descend into an
# excluded directory to pick the .gitkeep back up.
!targets/*/sdk/
!targets/*/config/
targets/*/sdk/*
targets/*/config/*
!targets/*/sdk/.gitkeep
!targets/*/config/.gitkeep

# Vendor files backed up by --rf-config before the u-blox version is applied.
*.ubx-orig

# Vendor SDKs. Fetched on demand by each target's `clone` command, never
# committed: together they are several GB and each user only needs their own.
mcuxpresso-sdk/
esp-idf/
ameba-rtos-d/

# west metadata
.west/
