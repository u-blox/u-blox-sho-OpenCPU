<#-- Create additional, part family specific symbols that are required-->
<#assign SYMBOLS_FILE = "symbols_${chipFamily}.ldt">
<#include SYMBOLS_FILE ignore_missing=true>


    FLASH_BASE_ADDRESS  = 0x08000000;
    FLASH_TOTAL_SIZE    = 0x00800000;
    LITTLEFS_REGION_SIZE = 0x00200000;

    /*** littleFS configuration Start ***/
    EDGEFAST_BT_LITTLEFS_STORAGE_START_ADDRESS = FLASH_BASE_ADDRESS + FLASH_TOTAL_SIZE - LITTLEFS_REGION_SIZE;
    EDGEFAST_BT_LITTLEFS_STORAGE_SECTOR_SIZE   = 0x1000;  /* 4k flash sector size */
    EDGEFAST_BT_LITTLEFS_STORAGE_MAX_SECTORS   = LITTLEFS_REGION_SIZE / EDGEFAST_BT_LITTLEFS_STORAGE_SECTOR_SIZE;
    ASSERT(FLASH_TOTAL_SIZE > LITTLEFS_REGION_SIZE, "Flash size must be larger than LITTLEFS region size")
    /*** littleFS configuration End ***/
