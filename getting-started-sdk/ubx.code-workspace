{
  "folders": [
    {
      "path": ".",
      "name": "getting-started-sdk"
    },
    {
      "path": "..",
      "name": "Repository Root (u-blox assets)"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:getting-started-sdk}/.venv/Scripts/python.exe",
    "cmake.configureOnOpen": false,
    "editor.formatOnSave": true,
    "[python]": {
      "editor.defaultFormatter": "ms-python.python",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "[markdown]": {
      "editor.wordWrap": "on",
      "editor.formatOnSave": true
    },
    "files.exclude": {
      "getting-started-sdk": true,
      "**/.git": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": false
    },
    "search.exclude": {
      "**/.venv": true,
      "**/sdks/**": true
    },
    "files.watcherExclude": {
      "**/sdks/**": true
    },
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder:getting-started-sdk}"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder:getting-started-sdk}"
    },
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder:getting-started-sdk}"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-cmake-tools.cmake-tools",
      "ms-vscode.cmake-language-support",
      "marus25.cortex-debug",
      "nordic-semiconductor.nrf-connect-extension-pack",
      "NXPSemiconductors.mcuxpresso",
      "espressif.esp-idf-extension",
      "gitlab.gitlab-workflow"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: IRIS-W10 doctor",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/iris_w10_build.py",
        "args": [
          "doctor"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: IRIS-W10 clone",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/iris_w10_build.py",
        "args": [
          "clone",
          "--full"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: IRIS-W10 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/iris_w10_build.py",
        "args": [
          "build",
          "hello_world"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W50-W51 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/nora_w50_w51_build.py",
        "args": [
          "build",
          "ble_wifi_provisioning"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W40 clone",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/nora_w40_build.py",
        "args": [
          "clone"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W40 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/nora_w40_build.py",
        "args": [
          "build",
          "hello_world"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: NORA-W30 build",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/nora_w30_build.py",
        "args": [
          "build"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Python: Setup venv",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/setup_venv.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Cortex Debug: NORA-W30 KM4 attach (J-Link)",
        "type": "cortex-debug",
        "request": "attach",
        "servertype": "jlink",
        "device": "RTL872xCS",
        "interface": "swd",
        "executable": "${workspaceFolder:getting-started-sdk}/sdks/ameba-rtos-d/main/project/realtek_amebaD_va0_example/GCC-RELEASE/project_hp/asdk/image/target_img2.axf",
        "cwd": "${workspaceFolder:getting-started-sdk}"
      },
      {
        "name": "Serial Logger (all boards)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/serial_logger.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      },
      {
        "name": "Flash Helper (multi-board)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:getting-started-sdk}/scripts/flash_helper.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:getting-started-sdk}",
        "justMyCode": false
      }
    ]
  }
}