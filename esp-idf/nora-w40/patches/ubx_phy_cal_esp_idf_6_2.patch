Subject: [PATCH] allow to redefine phy_init with offset values (ESP-IDF 6.2)

Same change as ubx_phy_cal_esp_idf_5_1.patch, re-cut against ESP-IDF 6.2:
esp_wifi's PRIV_REQUIRES list changed, so the 5.1 hunk no longer applies.
---
 components/esp_phy/src/phy_init.c  | 10 +++++-----
 components/esp_wifi/CMakeLists.txt |  2 +-
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/components/esp_phy/src/phy_init.c b/components/esp_phy/src/phy_init.c
--- a/components/esp_phy/src/phy_init.c
+++ b/components/esp_phy/src/phy_init.c
@@ -704,11 +704,11 @@ void esp_phy_release_init_data(const esp_phy_init_data_t* init_data)
 
 // phy_init_data.h will declare static 'phy_init_data' variable initialized with default init data
 
-const esp_phy_init_data_t* esp_phy_get_init_data(void)
-{
-    ESP_LOGD(TAG, "loading PHY init data from application binary");
-    return &phy_init_data;
-}
+// const esp_phy_init_data_t* esp_phy_get_init_data(void)
+// {
+//     ESP_LOGD(TAG, "loading PHY init data from application binary");
+//     return &phy_init_data;
+// }
 
 void esp_phy_release_init_data(const esp_phy_init_data_t* init_data)
 {
diff --git a/components/esp_wifi/CMakeLists.txt b/components/esp_wifi/CMakeLists.txt
--- a/components/esp_wifi/CMakeLists.txt
+++ b/components/esp_wifi/CMakeLists.txt
@@ -80,7 +80,7 @@ idf_component_register(SRCS "${srcs}"
 
                     REQUIRES esp_event esp_phy esp_netif
                     PRIV_REQUIRES esp_pm esp_timer nvs_flash efuse
-                                  wpa_supplicant hal lwip esp_coex
+                                  wpa_supplicant hal lwip esp_coex ubx_phy_cal
                     PRIV_INCLUDE_DIRS ../wpa_supplicant/src/ ../wpa_supplicant/esp_supplicant/src/
                                   wifi_apps/roaming_app/include wifi_apps/roaming_app/src
                     LDFRAGMENTS "${ldfragments}")
